  "text.autoconfig.genshinthirdperson.option.smoothCameraClip.transitionMode.ease-in": "淡入",
  "text.autoconfig.genshinthirdperson.option.smoothCameraClip.transitionMode.ease-out": "淡出",
  "text.autoconfig.genshinthirdperson.option.smoothCameraClip.transitionMode.ease-in-out": "淡入淡出",
  "text.autoconfig.genshinthirdperson.option.smoothCameraClip.transitionMode.genshin-impact-1": "原神(1)",
  "text.autoconfig.genshinthirdperson.option.smoothCameraClip.transitionMode.genshin-impact-2": "原神(2)",
