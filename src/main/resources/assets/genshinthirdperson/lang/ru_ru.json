  "text.autoconfig.genshinthirdperson.option.smoothCameraClip.transitionMode.ease-in": "Плавный вход",
  "text.autoconfig.genshinthirdperson.option.smoothCameraClip.transitionMode.ease-out": "Плавный выход",
  "text.autoconfig.genshinthirdperson.option.smoothCameraClip.transitionMode.ease-in-out": "Плавный вход-выход",
